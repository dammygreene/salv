# Optional. Solana JSON-RPC endpoint used for wallet scanning.
# Defaults to the public https://api.mainnet-beta.solana.com endpoint,
# which is heavily rate-limited and should not be used for production load.
# For real usage, point this at the configured QuickNode Solana endpoint
# Triton, Ankr, etc.) so scans don't get throttled.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Public CULLER launch configuration. NEXT_PUBLIC_* values are embedded at
# build time, so changing them requires a new production build/redeploy.
NEXT_PUBLIC_CULLER_MINT_ADDRESS=
NEXT_PUBLIC_CULLER_TOKEN_SYMBOL=CULLER
NEXT_PUBLIC_CULLER_TOKEN_NAME=CULLER
NEXT_PUBLIC_CULLER_NETWORK=mainnet-beta
NEXT_PUBLIC_SITE_URL=https://cullerlabs.xyz

# Server-side Solana RPC used for authoritative reward snapshots.
SOLANA_RPC_URL=
DATABASE_URL=
# Fixed allocation rate is snapshotted immutably on each new epoch.
# The approved rate for the next campaign is 100 whole CULLER per point.
CULLER_TOKENS_PER_POINT=100
CULLER_MIN_TOKEN_VALUE_USD=0.01
CULLER_MIN_VALUE_USD=0.01
CULLER_MAX_QUOTE_CANDIDATES=24
CULLER_LOW_LIQUIDITY_PRICE_IMPACT_BPS=500
CULLER_MIN_LIQUIDITY_USD=
OPENSEA_API_KEY=
MAGIC_EDEN_API_KEY=
CULLER_TOKEN_METADATA_TTL_MS=86400000
CULLER_NFT_METADATA_TTL_MS=86400000
CULLER_TOKEN_MARKET_TTL_MS=900000
CULLER_NFT_MARKET_TTL_MS=1800000
CULLER_COLLECTION_MARKET_TTL_MS=1800000
CULLER_MAX_NFT_MARKET_CANDIDATES=24
CULLER_ENRICHMENT_TIME_BUDGET_MS=45000

# Server-side Robinhood Chain RPC. Robinhood wallet scanning is optional;
# without this URL, Solana scans remain usable and Robinhood reports unavailable.
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=4663
# Indexed token/NFT discovery. The official public Robinhood Chain
# Blockscout endpoint is used by default; override for a dedicated provider.
ROBINHOOD_INDEXER_URL=https://robinhoodchain.blockscout.com/api/v2
# Optional server-only Blockscout API key. Required by some indexed
# providers for non-empty address queries. Never expose as NEXT_PUBLIC_*.
ROBINHOOD_INDEXER_API_KEY=
DEV_ADMIN_SECRET=
