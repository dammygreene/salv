# Optional. Solana JSON-RPC endpoint used for wallet scanning.
# Defaults to the public https://api.mainnet-beta.solana.com endpoint,
# which is heavily rate-limited and fine for light/demo traffic only.
# For real usage, point this at a dedicated provider (Helius, QuickNode,
# Triton, Ankr, etc.) so scans don't get throttled.
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- $SALV (Phase 5, Devnet only for now) -----------------------------
# All of these are server-only -- never prefix any of them with
# NEXT_PUBLIC_. See env.example.md for what each one does and
# docs/salv-architecture.md / docs/salv-devnet-claim-checklist.md for the
# full picture. Leaving these unset is the normal, expected state until
# scripts/salv/deploy-devnet-mint.ts has actually been run; every $SALV
# endpoint reports "not configured" rather than crashing.
SALV_MINT_ADDRESS=
SALV_REWARD_VAULT=
SALV_DISTRIBUTOR=
SALV_DISTRIBUTOR_SECRET_KEY=
SALV_FEE_WALLET=
SALV_NETWORK=devnet
SOLANA_RPC_URL=
