# Optional. Solana JSON-RPC endpoint used for wallet scanning.
# Defaults to the public https://api.mainnet-beta.solana.com endpoint,
# which is heavily rate-limited and fine for light/demo traffic only.
# For real usage, point this at a dedicated provider (Helius, QuickNode,
# Triton, Ankr, etc.) so scans don't get throttled.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Public CULLER launch configuration. NEXT_PUBLIC_* values are embedded at
# build time, so changing them requires a new production build/redeploy.
NEXT_PUBLIC_CULLER_MINT_ADDRESS=
NEXT_PUBLIC_CULLER_TOKEN_SYMBOL=CULLER
NEXT_PUBLIC_CULLER_TOKEN_NAME=CULLER
NEXT_PUBLIC_CULLER_NETWORK=mainnet-beta
NEXT_PUBLIC_SITE_URL=https://cullerlabs.xyz

# Server-side Solana RPC used for authoritative reward snapshots.
SOLANA_RPC_URL=
